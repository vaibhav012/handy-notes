<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fullLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:gravity="center"
    tools:context=".EditWidget">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:background="@drawable/rounded_card"
        android:elevation="12dp"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/widgetEditorNoteTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:maxLines="1"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Open note in Handy Notes"
                android:textColor="@color/on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <EditText
            android:id="@+id/widgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_edittext"
            android:gravity="top|start"
            android:hint="Enter your note text..."
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="12"
            android:minLines="6"
            android:padding="14dp"
            android:textColor="@color/on_background"
            android:textColorHint="@color/outline"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/rounded_button_secondary"
                android:minWidth="80dp"
                android:text="Cancel"
                android:textColor="@color/on_background"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/update"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/rounded_button_primary"
                android:minWidth="80dp"
                android:text="Update"
                android:textColor="@color/on_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/noteRefreshSpinner"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:indeterminate="true"
        android:visibility="gone"
        android:contentDescription="Refreshing note" />

</RelativeLayout>
