<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background"
    tools:context=".ExportImportActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/header_background"
        android:elevation="4dp"
        app:titleTextColor="@color/header_title"
        android:theme="@style/ThemeOverlay.AppCompat.DayNight.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export &amp; Import Notes"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Safely backup your notes or restore them from a JSON file."
                android:textSize="14sp"
                android:textColor="@color/outline"
                android:layout_marginBottom="20dp" />

            <!-- Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_card"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total notes: 0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Export Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Export Notes"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Export all your notes to a JSON file. You can save this backup file or transfer it to another device."
                    android:textSize="13sp"
                    android:textColor="@color/outline"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/exportButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Export to JSON"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/rounded_button_primary"
                    android:textColor="@color/on_primary" />

            </LinearLayout>

            <!-- Import Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Import Notes"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Import notes from a previously exported JSON file. Note: This will replace existing notes."
                    android:textSize="13sp"
                    android:textColor="@color/outline"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/importButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Import from JSON"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/rounded_button_secondary"
                    android:textColor="@color/on_background" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
