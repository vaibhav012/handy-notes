<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background"
    tools:context=".ExportImportActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export/Import Notes"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export your notes to a JSON file or import notes from a previously exported file."
                android:textSize="14sp"
                android:textColor="@color/outline"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total notes: 0"
                android:textSize="16sp"
                android:textColor="@color/on_background"
                android:layout_marginBottom="32dp"
                android:padding="16dp"
                android:background="@drawable/rounded_card"
                android:gravity="center" />

            <Button
                android:id="@+id/exportButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export Notes"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/rounded_button_primary"
                android:textColor="@color/on_primary"
                android:padding="16dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export all your notes to a JSON file. You can save this file and import it later or share it with other devices."
                android:textSize="12sp"
                android:textColor="@color/outline"
                android:layout_marginBottom="32dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <Button
                android:id="@+id/importButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Import Notes"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/rounded_button_secondary"
                android:textColor="@color/on_background"
                android:padding="16dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Import notes from a previously exported JSON file. This will replace all existing notes with the imported ones."
                android:textSize="12sp"
                android:textColor="@color/outline"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </LinearLayout>

    </ScrollView>

</RelativeLayout>

