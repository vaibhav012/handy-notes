<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background"
    tools:context=".Home">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/home_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/header_background"
        android:elevation="4dp"
        app:titleTextColor="@color/header_title"
        android:theme="@style/ThemeOverlay.AppCompat.DayNight.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight" />

    <ListView
        android:id="@+id/noteListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/home_toolbar"
        android:layout_above="@+id/addNote"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:background="@color/background"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <!-- Empty State Container -->
    <LinearLayout
        android:id="@+id/noNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_note"
            app:tint="@color/outline"
            android:contentDescription="No notes" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No Notes Yet"
            android:textColor="@color/on_background"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tap below to create your first note!"
            android:textColor="@color/outline"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Add Note Expanded Card -->
    <LinearLayout
        android:id="@+id/addNoteLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@drawable/rounded_card"
        android:elevation="8dp"
        android:padding="20dp"
        android:layout_margin="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Note"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/addNoteName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Title (optional)"
            android:background="@drawable/rounded_edittext"
            android:textColor="@color/on_background"
            android:textColorHint="@color/outline"
            android:padding="14dp"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/addNoteNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="3"
            android:hint="Write your note..."
            android:gravity="top|start"
            android:background="@drawable/rounded_edittext"
            android:textColor="@color/on_background"
            android:textColorHint="@color/outline"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/addNoteButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Add Note"
            android:background="@drawable/rounded_button_primary"
            android:textColor="@color/on_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bottom Add Note Trigger Button -->
    <Button
        android:id="@+id/addNote"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:text="+ Add New Note"
        android:background="@drawable/rounded_button_primary"
        android:textColor="@color/on_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="4dp" />

    <!-- Context Options Overlay -->
    <RelativeLayout
        android:id="@+id/optionsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A0000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:background="@drawable/rounded_card"
            android:padding="20dp"
            android:elevation="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Note Options"
                android:textColor="@color/on_surface"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/deleteNote"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Delete Note"
                android:background="@drawable/rounded_button_danger"
                android:textColor="@color/on_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
