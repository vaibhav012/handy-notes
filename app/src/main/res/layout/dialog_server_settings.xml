<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Server and Supabase Settings"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:paddingBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Server Base URL"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary"
        android:paddingTop="8dp" />

    <EditText
        android:id="@+id/editServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://notes.craftedalcove.in"
        android:inputType="textUri"
        android:singleLine="true"
        android:padding="12dp"
        android:background="@drawable/rounded_edittext"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Supabase Project URL"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary"
        android:paddingTop="16dp" />

    <EditText
        android:id="@+id/editSupabaseUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://your-project.supabase.co"
        android:inputType="textUri"
        android:singleLine="true"
        android:padding="12dp"
        android:background="@drawable/rounded_edittext"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Supabase Publishable Key"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary"
        android:paddingTop="16dp" />

    <EditText
        android:id="@+id/editPublishableKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="sb_publishable_…"
        android:inputType="textVisiblePassword"
        android:singleLine="true"
        android:padding="12dp"
        android:background="@drawable/rounded_edittext"
        android:layout_marginTop="4dp" />

</LinearLayout>
