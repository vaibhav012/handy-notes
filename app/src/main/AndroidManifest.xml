<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme" >

        <activity
            android:name=".Home"
            android:label="Handy Notes"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".NoteView"
            android:parentActivityName=".Home"
            android:label="Note"
            android:noHistory="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" >
        </activity>

        <activity
            android:name=".EditWidget"
            android:label=""
            android:noHistory="true"
            android:theme="@style/Theme.Translucent" >
        </activity>

        <activity
            android:name=".ExportImportActivity"
            android:parentActivityName=".Home"
            android:label="Export/Import"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" >
        </activity>


        <receiver
            android:name=".WidgetManager"
            android:exported="true"
            android:label="Handy Notes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="vv.utility.vaibhav.handynotes.PREV_NOTE" />
                <action android:name="vv.utility.vaibhav.handynotes.NEXT_NOTE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_manager" />
        </receiver>

        <service
            android:name=".WidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

    </application>

</manifest>
